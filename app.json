{
  "expo": {
    "name": "AssetGuard",
    "slug": "assetguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meridian.assetguard"
    },
    "android": {
      "package": "com.meridian.assetguard"
    }
  }
}
