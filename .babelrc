{
  "presets": ["@react-native/babel-preset"],
  "plugins": [
    [
      "module-resolver",
      {
        "alias": {
          "@": "./src",
          "@components": "./src/components",
          "@screens": "./src/screens",
          "@database": "./src/database",
          "@services": "./src/services",
          "@types": "./src/types",
          "@utils": "./src/utils",
          "@hooks": "./src/hooks",
          "@navigation": "./src/navigation",
          "@store": "./src/store"
        }
      }
    ]
  ]
}
