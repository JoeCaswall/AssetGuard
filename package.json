{
  "name": "assetguard",
  "version": "1.0.0",
  "description": "Offline-first inspection job management app for field engineers",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "react-native run-android --variant=debug",
    "android:release": "cd android && ./gradlew assembleRelease && cd ..",
    "windows": "react-native run-windows",
    "windows:dev": "react-native run-windows --dev",
    "windows:release": "react-native run-windows --release",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "eas prebuild --platform android",
    "prebuild:windows": "eas prebuild --platform windows"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-windows": "^0.73.0",
    "@react-native-camera-roll/camera-roll": "^7.5.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native-stack": "^6.9.17",
    "react-native-screens": "^3.28.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-reanimated": "^3.6.2",
    "@react-redux/hooks": "^2.0.2",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "react-redux": "^8.1.3",
    "immer": "^10.0.3",
    "sqlite3": "^5.1.6",
    "react-native-sqlite-storage": "^6.0.0",
    "watermelondb": "^0.29.0",
    "@nozbe/watermelondb": "^0.29.0",
    "async-storage": "^1.21.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/react": "^18.2.39",
    "@types/react-native": "^0.73.0",
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-native": "^4.1.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@babel/core": "^7.23.5",
    "@babel/preset-typescript": "^7.23.3",
    "babel-jest": "^29.7.0",
    "prettier": "^3.1.1",
    "metro-react-native-babel-preset": "^0.77.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "react-native",
    "offline-first",
    "sqlite",
    "inspection",
    "field-service"
  ]
}
